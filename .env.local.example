# Copy this file to .env.local and fill in your real values.
# .env.local is never committed to GitHub (see .gitignore).

# 1. Go to https://formspree.io and create a free account.
# 2. Create a new form. Formspree gives you an endpoint URL that looks like:
#      https://formspree.io/f/abcd1234
# 3. Paste it below, replacing the placeholder.
#
# Until this is set to a real endpoint, the inquiry form on the site will
# still work end-to-end for visitors to click through, but submissions are
# only logged to the browser console instead of being emailed to you.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/REPLACE_ME
